---
interface Props {
  active: 'cierre';
}

const { active } = Astro.props;
const activeClass = 'whitespace-nowrap rounded-lg bg-stone-950 py-2.5 font-bold text-white';
const inactiveClass = 'whitespace-nowrap rounded-lg py-2.5 font-bold text-stone-500 transition hover:bg-stone-200 hover:text-stone-950';
---

<nav class="mb-4 grid grid-cols-2 items-center gap-1 border-b border-stone-300 pb-2 sm:mb-5 sm:flex sm:gap-2 sm:overflow-x-auto sm:pb-3" aria-label="Herramientas">
  <a class={`${active === 'cierre' ? activeClass : inactiveClass} px-2 text-center text-xs sm:px-4 sm:text-sm`} href="/" aria-current={active === 'cierre' ? 'page' : undefined}>Cierre diario</a>
</nav>
