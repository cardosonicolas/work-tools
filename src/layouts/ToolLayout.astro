---
import Layout from './Layout.astro';
import ToolNavigation from '../components/ToolNavigation.astro';

interface Props {
  title?: string;
  activeTool: 'cierre';
}

const {
  title = 'Work Tools · Cierre diario',
  activeTool,
} = Astro.props;
---

<Layout title={title}>
  <main class="min-h-screen bg-[#f3f1eb] text-stone-900">
    <div class="mx-auto max-w-7xl px-4 py-5 sm:px-8 sm:py-8">
      <header class="mb-10 flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-3" aria-label="Work Tools, inicio">
          <span class="grid size-9 place-items-center rounded-xl bg-stone-950 font-display font-bold text-amber-300 shadow-lg shadow-stone-900/10">W</span>
          <span class="font-display text-lg font-bold tracking-tight">work<span class="text-amber-700">/</span>tools</span>
        </a>
      </header>

      <ToolNavigation active={activeTool} />
      <slot />

      <footer class="mt-8 flex flex-wrap justify-between gap-x-4 gap-y-2 text-xs font-medium text-stone-400">
        <span>Work Tools</span>
        <span>
          Developed by
          <a
          class="transition-colors hover:text-stone-700"
          href="https://cardosonicolas.github.io/"
          target="_blank"
          rel="noreferrer"> Nicolas Cardoso
        </a>
        </span>
      </footer>
    </div>
  </main>
</Layout>
